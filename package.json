{
  "name": "pyronaut-full-stack-template",
  "private": true,
  "version": "0.1.0",
  "description": "React SSR and hydration bundles for the Pyronaut full-stack template.",
  "scripts": {
    "build": "webpack --mode production --config webpack.server.cjs && webpack --mode production --config webpack.client.cjs",
    "watch": "webpack --mode development --watch --config webpack.server.cjs & webpack --mode development --watch --config webpack.client.cjs",
    "test": "jest",
    "lint": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true ./frontend",
    "generate-client": "./scripts/generate-client.sh",
    "verify:ssr": "node frontend/ssr-smoke.mjs",
    "check": "npm run test && npm run build && npm run verify:ssr"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.30.1",
    "text-encoding": "0.7.0",
    "web-streams-polyfill": "4.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@babel/preset-react": "7.27.1",
    "@biomejs/biome": "2.5.6",
    "@hey-api/openapi-ts": "0.97.3",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "babel-jest": "30.0.5",
    "babel-loader": "10.0.0",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "typescript": "^5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/frontend/jest.setup.js"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "testMatch": [
      "<rootDir>/frontend/**/*.test.jsx"
    ]
  }
}
