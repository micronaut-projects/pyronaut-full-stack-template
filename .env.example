# Copy to .env and edit. Loaded in the `dev` and `test` environments only;
# production reads real environment variables.
#
# The application refuses to start outside development while any value below
# is still `changethis`.

APP_NAME="Pyronaut Full Stack Project"

# Signing key for access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=changethis

# The first superuser, created on startup if it does not exist.
APP_FIRST_SUPERUSER=admin@example.com
APP_FIRST_SUPERUSER_PASSWORD=changethis

# Where password-reset links point.
APP_FRONTEND_HOST=http://localhost:8080

# Outbound email. In development these are supplied by Mailpit; see README.
APP_EMAILS_FROM_EMAIL=info@example.com
APP_EMAILS_FROM_NAME="Pyronaut Full Stack Project"

# MySQL. Left unset in development so Micronaut Test Resources starts a
# container and supplies them. Set all three to point at a real database.
# DATASOURCES_DEFAULT_URL=jdbc:mysql://localhost:3306/app
# DATASOURCES_DEFAULT_USERNAME=app
# DATASOURCES_DEFAULT_PASSWORD=changethis
